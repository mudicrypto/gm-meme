# Copy to apps/api/.env and fill in. Never commit the real .env.

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Stay on devnet until the security review (Step 8) is done.
SOLANA_CLUSTER=devnet

# Helius (Solana data): https://dashboard.helius.dev
HELIUS_API_KEY=
# Random string Helius sends back on each webhook call. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HELIUS_WEBHOOK_SECRET=
# Comma-separated programs to watch. Defaults to the pump.fun program.
HELIUS_WATCH_ADDRESSES=
# Poll Helius every N ms (0 = off). Use locally instead of a webhook.
HELIUS_POLL_INTERVAL_MS=0

# Jupiter (test sales for the risk score; mainnet only). The free lite API needs no key.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# Trading (Step 6). Devnet only until the security review sets ALLOW_MAINNET_TRADING=true.
# FEE_WALLET is a public address you control (never a private key); leave empty for no fee.
# The mobile app must be built with the same address in EXPO_PUBLIC_FEE_WALLET.
FEE_WALLET=
PLATFORM_FEE_BPS=50
ALLOW_MAINNET_TRADING=false

# Supabase (Postgres). The service role key is server-only: never ship it to the app.
# Leave empty to use an in-memory store (data is lost on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call the API (only the web build needs this).
CORS_ORIGINS=http://localhost:8081

# Claude API (AI summaries): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model for AI token summaries.
SUMMARY_MODEL=claude-opus-5-5
