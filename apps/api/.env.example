# Copy to apps/api/.env and fill in. Never commit the real .env.

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Stay on devnet until the security review (Step 8) is done.
SOLANA_CLUSTER=devnet

# Helius (Solana data): https://dashboard.helius.dev
HELIUS_API_KEY=
# Random string Helius sends back on each webhook call. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HELIUS_WEBHOOK_SECRET=
# Comma-separated programs to watch. Defaults to the pump.fun program.
HELIUS_WATCH_ADDRESSES=
# Poll Helius every N ms (0 = off). Use locally instead of a webhook.
HELIUS_POLL_INTERVAL_MS=0

# Jupiter (test sales for the risk score; mainnet only). The free lite API needs no key.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# Trading (Step 6). Devnet only until the security review sets ALLOW_MAINNET_TRADING=true.
# FEE_WALLET defaults to Sift's fee wallet (SIFT_FEE_WALLET in packages/shared). Set it to
# another public address to override, or to empty for no fee. The app must agree.
# FEE_WALLET=
PLATFORM_FEE_BPS=50
ALLOW_MAINNET_TRADING=false

# Supabase (Postgres). The service role key is server-only: never ship it to the app.
# Leave empty to use an in-memory store (data is lost on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call the API (only the web build needs this).
CORS_ORIGINS=http://localhost:8081

# Claude API (AI summaries): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model for AI token summaries.
SUMMARY_MODEL=claude-opus-5-5

# Sift wallet (devnet only). Privy holds the wallet keys; Sift never sees them.
# From https://dashboard.privy.io: the app ID and secret, the authorization key you create
# there (starts with wallet-auth:), and that key's (or key quorum's) ID. All or none.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_OWNER_ID=

# Public pages for the app stores (/privacy, /terms, /support).
SUPPORT_EMAIL=
OPERATOR_NAME=
# Emergency switch: true stops all Sift wallet signing.
SIFT_SIGNING_FROZEN=false
# How often the order engine checks prices (ms; 0 = off).
ORDER_CHECK_INTERVAL_MS=15000

# Price alerts: how often to check (ms; 0 = off), and an optional Expo push access token
# (only needed if "enhanced push security" is on in your Expo project).
ALERT_CHECK_INTERVAL_MS=60000
EXPO_ACCESS_TOKEN=

# Abuse limits. Requests per minute per IP for ordinary routes (expensive routes are stricter),
# proxies in front of the API (so limits see the real client IP; 0 = none), and a hard cap
# on Claude calls per hour for AI summaries.
RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY_HOPS=0
SUMMARY_MAX_CALLS_PER_HOUR=300
