{
  "name": "@sift/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sift API server: discovery, risk scores, AI summaries, social and swap quotes.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "helius:webhook": "tsx --env-file-if-exists=.env scripts/register-helius-webhook.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/cors": "^11.3.1",
    "@sift/shared": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
