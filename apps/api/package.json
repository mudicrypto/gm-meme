{
  "name": "@sift/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sift API server: discovery, risk scores, AI summaries, social and swap quotes.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sift/shared": "workspace:*",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
