# Copy to apps/mobile/.env. EXPO_PUBLIC_* values are bundled into the app and
# visible to anyone, so never put secrets here.

# Your machine's LAN IP when testing on a phone, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Platform fee wallet (a public address). Must match the API's FEE_WALLET: the app refuses
# to sign any trade that sends fees anywhere else. Leave empty when the API charges no fee.
EXPO_PUBLIC_FEE_WALLET=
