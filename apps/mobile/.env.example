# Copy to apps/mobile/.env. EXPO_PUBLIC_* values are bundled into the app and
# visible to anyone, so never put secrets here.

# Your machine's LAN IP when testing on a phone, e.g. http://192.168.1.20:3000
# Or the live test server (devnet): https://sift-api-ggmv.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Platform fee wallet the app accepts. Defaults to Sift's (SIFT_FEE_WALLET in packages/shared);
# must match the API's FEE_WALLET, or the app refuses every trade. Empty = accept no fee.
# EXPO_PUBLIC_FEE_WALLET=

# Web page Phantom shows on its "connect" screen (name and icon are read from it).
# EXPO_PUBLIC_APP_URL=https://github.com/mudicrypto/gm-meme
