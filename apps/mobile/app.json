{
  "expo": {
    "name": "Sift",
    "slug": "sift",
    "scheme": "sift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sift.mobile",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.sift.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#72E5C0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Sift",
      "shortName": "Sift",
      "description": "Solana meme coins with a risk check on every token, the full cost before every trade, and your keys in your own wallet.",
      "themeColor": "#F6F7F2",
      "backgroundColor": "#F6F7F2"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0B7A4F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sift uses Face ID to confirm it’s you before showing your private key or removing your wallet."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F6F7F2",
          "resizeMode": "contain"
        }
      ]
    ],
    "backgroundColor": "#F6F7F2"
  }
}
