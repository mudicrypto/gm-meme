{
  "cli": {
    "version": ">= 24.12.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "10.28.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sift-api-ggmv.onrender.com"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk", "image": "latest" },
      "ios": { "image": "latest" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": { "image": "latest" },
      "ios": { "image": "latest" }
    }
  }
}
